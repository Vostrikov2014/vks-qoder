# Jitsi Management Platform - Environment Variables Template
# Copy this file to .env and fill in actual values
# DO NOT commit .env file to version control!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Public address of the JMP web UI as users see it in the browser. Join links for
# conferences are built from it, so it must match the reverse-proxy host, not the
# container address.
JMP_PUBLIC_URL=https://a.slamx.ru

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_URL=jdbc:postgresql://localhost:5432/jmp
DB_USER=jmp
DB_PASS=your_db_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=localhost
REDIS_PASS=

# =============================================================================
# JWT SECURITY CONFIGURATION
# =============================================================================
# Generate secure secrets (minimum 256 bits / 32 bytes for HS256)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# =============================================================================
# JITSI CONFIGURATION
# =============================================================================
# These variables feed the backend (jmp-api) that builds room links in both contours. In
# PRODUCTION the Jitsi web container (jitsi-meet/docker/55-jmp-config.sh) also rewrites its
# client config and signalling proxy from them at start, so switching to production is
# editing this file, never the code. In the LOCAL contour there is no web container: the UI
# is served by the dev server (see below).
#
# LOCAL  (docker-compose.dev.yml; `make dev` in jitsi-meet/ serves the UI on :8000 and
#         proxies signalling to Prosody :5280 and the JVB colibri-ws :9091 — no web
#         container):
#   JITSI_DOMAIN=localhost:8000   JITSI_SCHEME=http   JMP_PUBLIC_URL=http://localhost:5173
#   To join from a second machine: WEBPACK_DEV_SERVER_HOST=0.0.0.0 and
#   JITSI_DOMAIN=<lan-ip>:8000, and reach the same machine from the other client.
#
# PRODUCTION (docker-compose.yml, nginx-proxy.conf):
#   JITSI_DOMAIN=meet.slamx.ru    JITSI_SCHEME=https  JMP_PUBLIC_URL=https://a.slamx.ru
#
# Address of the Jitsi web UI as users see it; room links are built from it. A per-tenant
# tenants.jitsi_domain value overrides it. Keep it host[:port] without a path prefix.
JITSI_DOMAIN=meet.slamx.ru
JITSI_SCHEME=https
JITSI_JWT_APP_ID=jmp-platform
# Has to be byte-for-byte the same value as JWT_APP_SECRET of the jitsi-prosody container:
# Prosody uses it as a literal string, therefore JITSI_JWT_APP_SECRET_TYPE=raw (default).
# base64 only if Prosody was configured with the decoded key.
JITSI_JWT_APP_SECRET=your_jitsi_jwt_secret
JITSI_JWT_APP_SECRET_TYPE=raw
JITSI_JWT_AUDIENCE=jitsi
# Internal XMPP domain = Prosody's VirtualHost; goes into the `sub` claim of every token.
JITSI_XMPP_DOMAIN=meet.jitsi
# MUC component of Prosody (its `main_muc`), used by the web container's client config.
XMPP_MUC_DOMAIN=muc.meet.jitsi
# Keep two-person media on the bridge while there is no TURN server: without this, two
# participants behind NAT each see an empty conference.
DISABLE_P2P=true

# How long a Jitsi token embedded into a room address stays valid. Defaults to 240
# minutes; keep it above the expected length of a meeting, since a page reload inside
# a meeting reuses the same address.
# JITSI_JWT_TOKEN_TTL_MINUTES=240

# =============================================================================
# OPTIONAL: Monitoring & Observability
# =============================================================================
# PROMETHEUS_ENABLED=true
# JAEGER_ENDPOINT=http://localhost:14268/api/traces