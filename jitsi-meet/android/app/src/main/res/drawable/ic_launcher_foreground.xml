<?xml version="1.0" encoding="utf-8"?>
<!-- VKS TV: белая видеокамера (lucide Video) на безопасной зоне adaptive-icon.
     Геометрия точь-в-точь повторяет пропорции фирменного знака приложения
     (VksTvLogo.native.tsx): камера занимает ~5/8 ширины тайла (20 из 32
     единиц лупы), т.е. 62,5% видимой у лаунчера области 108 => контент
     48x28.8 по центру полотна. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group
      android:translateX="25.2"
      android:translateY="25.2"
      android:scaleX="2.4"
      android:scaleY="2.4">
    <!-- корпус камеры: rect x=2 y=6 w=14 h=12 rx=2 -->
    <path
        android:pathData="M4,6 L16,6 A2,2 0 0 1 18,8 L18,16 A2,2 0 0 1 16,18 L4,18 A2,2 0 0 1 2,16 L2,8 A2,2 0 0 1 4,6 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <!-- объектив -->
    <path
        android:pathData="M16,13 L21.223,16.482 a0.5,0.5 0 0 0 0.777,-0.416 L21.9999,7.87 a0.5,0.5 0 0 0 -0.752,-0.432 L16,10.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
  </group>
</vector>
